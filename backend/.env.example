# Server port (Render khud PORT deta hai, local me 5000)
PORT=5000

# MongoDB Atlas connection string (database name ke saath)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fitnova?retryWrites=true&w=majority

# JWT ke liye lamba random secret
JWT_SECRET=change-this-to-a-long-random-string

# Frontend ka URL (comma se multiple allowed). Khali chhodo to sab origins allow honge.
CLIENT_ORIGIN=http://localhost:5173
